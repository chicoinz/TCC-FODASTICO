<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof titulo !== 'undefined' ? titulo : 'VACCUM Co. — Aspirador de pó semiautomático' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="/Css/style.css" rel="stylesheet">
  <link href="/Css/header.css" rel="stylesheet">
  <script>
    // Aplica o tema antes da primeira pintura para evitar piscada de cor.
    (function () {
      var salvo = localStorage.getItem('darkMode');
      var escuro = salvo === null
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
        : salvo === 'true';
      if (escuro) document.documentElement.classList.add('dark-mode');
    })();
  </script>
</head>

<header class="app-header">
  <div class="header-container">
    <!-- Marca -->
    <a class="logo-section" href="/">
      <span class="logo-icon" aria-hidden="true"></span>
      <h1 class="company-name">VACCUM<span> Co.</span></h1>
    </a>

    <!-- Navegação -->
    <div class="header-center">
      <nav class="header-nav" aria-label="Navegação principal">
        <a href="/" class="header-link">Início</a>
        <a href="/#como-funciona" class="header-link">Como funciona</a>
        <a href="/#recursos" class="header-link">Recursos</a>
        <a href="/#ficha-tecnica" class="header-link">Ficha técnica</a>
      </nav>
    </div>

    <!-- Ações -->
    <div class="header-right">
      <a href="/#contato" class="btn-contact">Fale conosco</a>

      <button class="btn-theme" id="themeToggle" type="button" title="Alternar modo noturno" aria-label="Alternar modo noturno">
        <span class="theme-icon">🌙</span>
      </button>

      <div class="btn-group dropstart">
        <button class="btn-profile" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Perfil do usuário" aria-label="Perfil do usuário">
          <span class="profile-icon">👤</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><a class="dropdown-item" href="/usuario/login">Minha conta</a></li>
          <li><a class="dropdown-item" href="/usuario/login">Editar perfil</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/">Sair</a></li>
        </ul>
      </div>
    </div>

    <!-- Menu mobile -->
    <button class="header-toggle" id="headerToggle" type="button" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<script src="/Scripts/theme.js"></script>
