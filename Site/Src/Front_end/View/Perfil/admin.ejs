<!DOCTYPE html>
<html lang="pt-BR">
  <body>
    <%- include('../../Publico/Partials/header.ejs', { titulo: 'Painel administrativo — VACCUM Co.' }) %>
    <%- include('../../Publico/Partials/navbar.ejs') %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/Css/admin_forms.css">

    <main class="app-main">
      <div class="page-header">
        <h1 class="page-title">Painel administrativo</h1>
        <p class="page-subtitle">
          Gerencie o catálogo de aspiradores e os clientes cadastrados
        </p>
      </div>

      <div class="sections">
        <!-- Produtos -->
        <section class="section">
          <button class="accordion" type="button">Aspiradores</button>
          <div class="panel">
            <div class="form-card">
              <form action="/produto/produtoPorId" method="GET">
                <label for="id_produto">Id do aspirador</label>
                <input type="number" id="id_produto" name="id" required class="form-control">
                <div class="text-end">
                  <button type="submit" class="btn btn-primary">Buscar por ID</button>
                </div>
              </form>
            </div>

            <h3>Aspiradores cadastrados</h3>
            <div class="table-responsive">
              <table class="responsive-table">
                <thead>
                  <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Nome</th>
                    <th scope="col">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!produtos || produtos.length === 0) { %>
                    <tr>
                      <td colspan="3">Nenhum aspirador cadastrado.</td>
                    </tr>
                  <% } else { %>
                    <% (produtos || []).forEach(function(produto) { %>
                      <tr>
                        <td data-label="ID"><%= produto.id %></td>
                        <td data-label="Nome"><%= produto.nome %></td>
                        <td data-label="Estado"><%= produto.estado %></td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <h3 class="mt-3">Cadastrar novo aspirador</h3>
            <div class="form-card">
              <form action="/produto/criar" method="POST" enctype="multipart/form-data">
                <label for="produto-nome">Nome</label>
                <input type="text" id="produto-nome" name="nome" class="form-control">

                <label for="produto-modelo">Modelo</label>
                <input type="text" id="produto-modelo" name="modelo" class="form-control">

                <label for="produto-estado">Estado</label>
                <input type="text" id="produto-estado" name="estado" class="form-control">

                <label for="produto-descricao">Descrição</label>
                <textarea id="produto-descricao" name="descricao" class="form-control" rows="4"></textarea>

                <label for="produto-preco">Preço</label>
                <input type="number" id="produto-preco" name="preco" class="form-control" step="0.01">

                <label for="img">Imagem</label>
                <input type="file" name="imagem" id="img" accept="image/*" class="form-control">

                <div class="text-end">
                  <button type="submit" class="btn btn-success">Cadastrar aspirador</button>
                </div>
              </form>
            </div>
          </div>
        </section>

        <!-- Usuários -->
        <section class="section">
          <button class="accordion" type="button">Clientes</button>
          <div class="panel">
            <div class="form-card">
              <form action="/usuario/usuarioPorId" method="POST">
                <label for="id_usuario">Id do cliente</label>
                <input type="text" id="id_usuario" name="id_usuario" required class="form-control">
                <div class="text-end">
                  <button type="submit" class="btn btn-primary">Buscar por ID</button>
                </div>
              </form>
            </div>

            <h3>Clientes cadastrados</h3>
            <div class="table-responsive">
              <table class="responsive-table">
                <thead>
                  <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Nome</th>
                    <th scope="col">E-mail</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!usuarios || usuarios.length === 0) { %>
                    <tr>
                      <td colspan="3">Nenhum cliente encontrado.</td>
                    </tr>
                  <% } else { %>
                    <% (usuarios || []).forEach(function(usuario) { %>
                      <tr>
                        <td data-label="ID"><%= usuario.id %></td>
                        <td data-label="Nome"><%= usuario.nome %></td>
                        <td data-label="E-mail"><%= usuario.email %></td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>

      <form action="/admin/logout" method="GET" class="admin-logout">
        <button class="btn btn-danger" type="submit">Sair do painel</button>
      </form>
    </main>

    <%- include('../../Publico/Partials/footer.ejs') %>

    <script src="/Scripts/admin.js"></script>
  </body>
</html>
