<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin_perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin_forms.css">
</head>
<body>
    <%- include('../../Publico/partials/header.ejs') %>
    <%- include('../../Publico/partials/navbar.ejs') %>
    <main class="app-main">
    <header class="page-header">
        <h1 class="page-title">Perfil do Admin</h1>
        <p class="page-subtitle">Gerencie animais, responsáveis, adoções, veterinários e exames</p>

    </header>


    <div class="sections" style="padding: 10px;">

        <div class="section">
            <button class="accordion">Produtos</button>
            <div class="panel">
            <div class="form-card">
            <form action="/produto/produtoPorId" method="GET">
                <label for="id_produto">Id do produto</label>
                <input type="number" id="id_produto" name="id" required class="form-control">
                <div class="text-end"><button type="submit" class="btn btn-primary">Buscar por ID</button></div>
            </form>
            </div>
            <h3>Lista de produtos cadastrados:</h3>
            <div class="table-responsive">
                <table class="responsive-table" >
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Estado</th>
                        </tr>
                </thead>
                <tbody>
                    <% if (!produtos || produtos.length === 0) { %>
                    <tr>
                        <td colspan="5">Nenhum produto cadastrado.</td>
                    </tr>
                    <% } else { %>
                    <% (produtos || []).forEach(function(produto) { %>
                    <tr>
                        <td data-label="ID"><%= produto.id %></td>
                        <td data-label="Nome"><%= produto.nome %></td>
                        <td data-label="Estado"><%= produto.estado %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                    </tr>
                </tbody>
            </table>
            </div>
            <div class="form-card">
                <form action="/produto/criar" method="POST" enctype="multipart/form-data">
                    <label>Nome</label>
                        <input type="text" name="nome" class="form-control">
                    <label>Modelo</label>
                        <input type="text" name="modelo" class="form-control">
                    <label>Estado</label>
                        <input type="text" name="estado" class="form-control">
                    <label>Descrição</label>
                        <textarea name="descricao" class="form-control" rows="4"></textarea>
                    <label>Preço</label>
                        <input type="number" name="preco" class="form-control" step="0.01">
                    <label>Imagem</label>
                    <input type="file" name="imagem" id="img" accept="image/*" class="form-control">
                    <div class="text-end"><button type="submit" class="btn btn-success">Cadastrar novo</button></div>
                </form>
            </div>
            </div>

            

            </div>
        </div>


        <div class="section">
            <button class="accordion">Usuarios</button>
            <div class="panel">
            <h3>Listar todos os usuários</h3>
            <div class="form-card">
            <form action="/usuario/usuarioPorId" method="POST">
                <label for="id_usuario">Id do usuário</label>
                <input type="text" id="id_usuario" name="id_usuario" required class="form-control">
                <div class="text-end"><button type="submit" class="btn btn-primary">Buscar por ID</button></div>
            </form>
            </div>
            <div class="table-responsive">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!usuarios || usuarios.length === 0) { %>
                    <tr>
                        <td colspan="3">Nenhum usuário encontrado.</td>
                    </tr>
                    <% } else { %>
                    <% (usuarios || []).forEach(function(usuario) { %>
                    <tr>
                        <td data-label="ID"><%= usuario.id %></td>
                        <td data-label="Nome"><%= usuario.nome %></td>
                        <td data-label="Email"><%= usuario.email %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
            </div>
        </div>
    </div>


    </div> <!-- .sections -->

            <div class="form-card" style="max-width:220px; text-align:center;">
            <form action="/admin/logout" method="GET">
                <button class="btn btn-danger" type="submit">Logout</button>
            </form>
            </div>
    </main>

    <%- include('../../Publico/partials/footer.ejs') %>

    <script src="/Scripts/admin.js"></script>
</body>
</html>