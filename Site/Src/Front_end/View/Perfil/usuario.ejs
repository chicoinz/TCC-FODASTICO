<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Responsavel_perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('../../Publico/partials/header.ejs') %>
    <%- include('../../Publico/partials/navbar.ejs') %>
    <main class="app-main">
    <div class="container-fluid">
        <h1>Olá, <%= nome %>!</h1>
    </div>

    <h2>Produtos para compra</h2>
    <div class="container-fluid">
        <div class="cards-grid" id="Card-resumido">
            <% (produtos || [] ).forEach(function(produto) { %>
                <div class="card" data-id="<%= produto.id %>">
                <div class="card-header bg-light">
                    <div class="card-header-custom">
                        <div class="avatar"><%= (produto.nome && produto.nome.charAt(0)) ? produto.nome.charAt(0).toUpperCase() : 'P' %></div>
                        <div>
                            <h5 class="card-title mb-1"><%= produto.nome %></h5>
                            <p class="card-text text-muted mb-0" style="font-size:13px"><strong>Modelo:</strong> <%= produto.modelo %></p>
                        </div>
                    </div>
                </div>
                <div class="card-body"></div>
                <div class="card-footer bg-light">
                    <form action="/carrinho/adicionar" method="POST" style="width:100%">
                        <input type="hidden" name="data" value="<%= new Date().toISOString().split('T')[0] %>">
                        <input type="hidden" name="produto_id" value="<%= produto.id %>">
                        <input type="hidden" name="usuario_id" value="<%= req.session.user.id %>">
                        <input type="hidden" name="nome_produto" value="<%= produto.nome %>">
                        <button type="submit" class="btn btn-primary btn-sm w-100" onclick="return confirm('Adicionar produto ao carrinho?')">Comprar</button>
                    </form>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
    </main>

    <form action="/responsavel/logout" method="POST" style="margin-left: var(--gap-lg); margin-bottom: var(--gap-lg);">
        <button type="submit" class="btn btn-danger">Logout</button>
    </form>

    <%- include('../../Publico/partials/footer.ejs') %>

    <script src="/Scripts/modalAnimal.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>

</body>
</html>