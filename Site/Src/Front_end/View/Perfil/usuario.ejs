<!DOCTYPE html>
<html lang="pt-BR">
  <body>
    <%- include('../../Publico/Partials/header.ejs', { titulo: 'Minha conta — VACCUM Co.' }) %>
    <%- include('../../Publico/Partials/navbar.ejs') %>

    <main class="app-main">
      <div class="container-fluid">
        <div class="section-head">
          <p class="eyebrow">Área do cliente</p>
          <h1>Olá, <%= nome %>!</h1>
          <p class="lead">
            Escolha o modelo de aspirador semiautomático que combina com a sua
            casa e adicione ao carrinho.
          </p>
        </div>

        <h2>Aspiradores disponíveis</h2>

        <div class="cards-grid" id="Card-resumido">
          <% if (!produtos || produtos.length === 0) { %>
            <p class="text-muted">
              Nenhum aspirador disponível no momento. Volte em breve.
            </p>
          <% } %>

          <% (produtos || []).forEach(function(produto) { %>
            <article class="card" data-id="<%= produto.id %>">
              <div class="card-header">
                <div class="card-header-custom">
                  <div class="avatar" aria-hidden="true">
                    <%= (produto.nome && produto.nome.charAt(0)) ? produto.nome.charAt(0).toUpperCase() : 'V' %>
                  </div>
                  <div>
                    <h3 class="card-title mb-0"><%= produto.nome %></h3>
                    <p class="card-text mb-0">
                      <strong>Modelo:</strong> <%= produto.modelo %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="card-body">
                <span class="badge">Semiautomático</span>
              </div>

              <div class="card-footer">
                <form action="/carrinho/adicionar" method="POST" class="w-100">
                  <input type="hidden" name="data" value="<%= new Date().toISOString().split('T')[0] %>">
                  <input type="hidden" name="produto_id" value="<%= produto.id %>">
                  <input type="hidden" name="usuario_id" value="<%= req.session.user.id %>">
                  <input type="hidden" name="nome_produto" value="<%= produto.nome %>">
                  <button
                    type="submit"
                    class="btn btn-primary btn-sm w-100"
                    onclick="return confirm('Adicionar este aspirador ao carrinho?')"
                  >
                    Adicionar ao carrinho
                  </button>
                </form>
              </div>
            </article>
          <% }); %>
        </div>

        <form action="/usuario/logout" method="POST" class="mt-3">
          <button type="submit" class="btn btn-danger">Sair da conta</button>
        </form>
      </div>
    </main>

    <%- include('../../Publico/Partials/footer.ejs') %>

    <script src="/Scripts/product_modal.js"></script>
  </body>
</html>
