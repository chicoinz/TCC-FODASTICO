<!DOCTYPE html>
<html lang="pt-BR">
  <body>
    <%- include('../../Publico/Partials/header.ejs', { titulo: 'Acesso administrativo — VACCUM Co.' }) %>

    <main class="app-main">
      <section class="auth-section">
        <div class="auth-card">
          <div class="auth-card-body">
            <p class="eyebrow">Área restrita</p>
            <h2 class="mb-1">Acesso administrativo</h2>
            <p class="text-muted mb-3">
              Informe a senha da equipe para gerenciar produtos e usuários.
            </p>

            <% if (messages.error && messages.error.length > 0) { %>
              <p class="alert alert-error">Erro: <%= messages.error[0] %></p>
            <% } %>

            <form action="/admin/" method="POST" class="auth-form">
              <div class="form-group">
                <label class="form-label" for="senha-admin">Senha</label>
                <input
                  type="password"
                  id="senha-admin"
                  class="form-control form-control-lg"
                  name="senha"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  required
                />
              </div>

              <button class="btn btn-warning btn-lg submit-btn" type="submit">
                Entrar como administrador
              </button>
            </form>

            <hr />

            <p class="text-muted">
              Não faz parte da equipe?
              <a href="/usuario/login">Acesse a área do cliente</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <%- include('../../Publico/Partials/footer.ejs') %>
  </body>
</html>
