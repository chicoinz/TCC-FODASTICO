<!DOCTYPE html>
<html lang="pt-BR">
  <body>
    <%- include('../../Publico/Partials/header.ejs', { titulo: 'Entrar — VACCUM Co.' }) %>

    <main class="app-main">
      <section class="auth-section">
        <div class="auth-card">
          <div class="auth-card-body">
            <p class="eyebrow">Área do cliente</p>
            <h2 class="mb-1">Bem-vindo de volta</h2>
            <p class="text-muted mb-3">
              Entre para acompanhar seus pedidos e comprar o seu VACCUM.
            </p>

            <% if (messages.error && messages.error.length > 0) { %>
              <p class="alert alert-error">Erro: <%= messages.error[0] %></p>
            <% } %>
            <% if (messages.success && messages.success.length > 0) { %>
              <p class="alert alert-success">Sucesso: <%= messages.success[0] %></p>
            <% } %>

            <form action="/usuario/" method="POST" class="auth-form">
              <div class="form-group">
                <label class="form-label" for="email">E-mail</label>
                <input
                  type="email"
                  id="email"
                  class="form-control form-control-lg"
                  name="email"
                  autocomplete="email"
                  placeholder="voce@exemplo.com.br"
                  required
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="senha">Senha</label>
                <input
                  type="password"
                  id="senha"
                  class="form-control form-control-lg"
                  name="senha"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  required
                />
              </div>

              <button class="btn btn-primary btn-lg submit-btn" type="submit">
                Entrar
              </button>
            </form>

            <hr />

            <p class="text-muted">
              Ainda não tem conta?
              <a href="/CriarConta/usuario.html">Crie a sua agora</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <%- include('../../Publico/Partials/footer.ejs') %>
  </body>
</html>
