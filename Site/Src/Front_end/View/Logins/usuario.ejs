<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login_responsavel</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link 
      href="../../Publico/css/style.css"
      rel="stylesheet"
    />
  </head>
  <body>
  <%- include('../../Publico/partials/header.ejs') %>

  <main class="app-main">
    <section class=" vh-100 auth-section " style="background-color: #508bfc">
      <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
          <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-2-strong auth-card" style="border-radius: 1rem">
              <div class="card-body p-5 text-center auth-card-body">

                <h3 class="mb-3">Login de Responsável</h3>
                <% if (messages.error && messages.error.length > 0) { %>
                <strong style="color: red"
                  >Erro: <%= messages.error[0] %></strong
                >
                <% } %>
                <% if (messages.success && messages.success.length > 0) { %>
                <strong style="color: green"
                  >Sucesso: <%= messages.success[0] %></strong
                >
                <% } %>
                <form action="/usuario/" method="POST" class="auth-form">
                  <div data-mdb-input-init class="form-outline mb-2">
                    <input
                      type="email"
                      id="typeEmailX-2"
                      class="form-control form-control-lg"
                      name="email"
                    />
                    <label class="form-label" for="typeEmailX-2">Email</label>
                  </div>

                  <div data-mdb-input-init class="form-outline mb-2">
                    <input
                      type="password"
                      id="typePasswordX-2"
                      class="form-control form-control-lg"
                      name="senha"
                    />
                    <label class="form-label" for="typePasswordX-2"
                      >Senha</label
                    >
                  </div>

              <button data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block" type="submit">Login</button>
            </form>
            <hr class="my-4">

            <p>Não possui uma conta? <a href="../CriarConta/usuario.html">Crie uma!</a></p>   
          </div>
        </div>
      </div>
    </div>
  </div>
  
</section>
</body>
</html>